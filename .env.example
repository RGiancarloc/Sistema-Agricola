# ===========================================================================
# Gemelo digital agricola - variables de entorno
# Copiar a `.env` y ajustar. El backend lee estas variables con prefijo SA_.
# ===========================================================================

# --- Backend / base de datos ---
# Ruta SQLite local (sin Docker):
SA_DATABASE_URL=sqlite:///./data/agricola.db
# URL PostGIS (con Docker Compose):
#SA_DATABASE_URL=postgresql+psycopg2://agricola:agricola@localhost:5432/agricola

# --- Reproducibilidad ---
SA_SEED=42

# --- Rutas de configuracion ---
SA_CONFIG_DIR=./config

# --- Servidor ---
SA_HOST=0.0.0.0
SA_PORT=8000

# --- CORS (frontend) ---
SA_CORS_ORIGINS=http://localhost:3000

# --- PostGIS (usado por docker-compose) ---
POSTGRES_USER=agricola
POSTGRES_PASSWORD=agricola
POSTGRES_DB=agricola
